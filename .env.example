# Conexão com o Neon PostgreSQL
# Runtime: role de privilégio mínimo (criado por `npm run db:setup-runtime-role`)
DATABASE_URL="postgresql://runtime:senha@host/neondb?sslmode=require"
# Owner: usado apenas por `npm run db:migrate`
MIGRATION_DATABASE_URL="postgresql://owner:senha@host/neondb?sslmode=require"

# Credenciais do role de runtime (usadas por `npm run db:setup-runtime-role`)
APP_DB_USER="app_runtime"
APP_DB_PASSWORD="senha-aleatoria-com-24-caracteres-ou-mais"

# Better Auth
BETTER_AUTH_SECRET="gere com: node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""
BETTER_AUTH_URL="http://localhost:5174"

# E-mails que acessam a lista. Sem ela em produção, ninguém acessa.
ALLOWED_EMAILS="pessoa1@exemplo.com,pessoa2@exemplo.com"

# Libera a tela de cadastro para qualquer e-mail. Em produção mantenha "false".
ALLOW_PUBLIC_SIGNUP="false"

# Contas permitidas (usadas por `npm run db:seed`)
SEED_USER_1_EMAIL="pessoa1@exemplo.com"
SEED_USER_1_PASSWORD="senha-forte-1"
SEED_USER_2_EMAIL="pessoa2@exemplo.com"
SEED_USER_2_PASSWORD="senha-forte-2"
